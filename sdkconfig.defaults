CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_IPC_TASK_STACK_SIZE=8096
CONFIG_LOG_VERSION_2=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_TAG_LEVEL_IMPL_NONE=y
CONFIG_LOG_DYNAMIC_LEVEL_CONTROL=n
CONFIG_LOG_COLORS=y
CONFIG_LOG_COLORS_SUPPORT=y
CONFIG_LOG_TIMESTAMP_SOURCE_SYSTEM=y
CONFIG_RMT_ENCODER_FUNC_IN_IRAM=y
CONFIG_RMT_RECV_FUNC_IN_IRAM=y
CONFIG_RMT_RX_ISR_CACHE_SAFE=y
CONFIG_RMT_RX_ISR_HANDLER_IN_IRAM=y
